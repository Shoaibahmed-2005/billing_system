# Copy to .env.local at the TOP OF THE REPOSITORY and fill in the blanks.
# Both sites read this one file — apps/billing and apps/quotations each point
# their envDir here, so there is a single set of keys to keep straight.
#
# ---------------------------------------------------------------------------
# THE RULE THAT MATTERS
#
# Anything named VITE_* is compiled into the JavaScript and is readable by
# anyone who opens the site. That is fine for the Supabase anon key, which is
# designed for it and is held back by row-level security. It is NOT fine for
# anything else. A WhatsApp token or a service-role key with a VITE_ prefix is
# a published secret, and no amount of care elsewhere undoes that.
#
# The unprefixed names below are for the reminder job, which runs on a server.
# They never belong in .env.local on a laptop and never reach the browser.
# ---------------------------------------------------------------------------


# --- both sites, in the browser --------------------------------------------
#
#   URL : Supabase dashboard -> Project Settings -> Data API
#   Key : Supabase dashboard -> Project Settings -> API Keys -> anon public
#
# Leave the key blank to keep running on this machine's browser storage,
# which is what local testing uses.

VITE_SUPABASE_URL=https://ablhveylchqtnkuynkjz.supabase.co
VITE_SUPABASE_ANON_KEY=


# --- the renewal reminder job, server side only ----------------------------
# Not needed until the WhatsApp reminders are built. Set these in the hosting
# dashboard, not in a file that gets committed.

# Supabase dashboard -> Project Settings -> API Keys -> service_role.
# Bypasses row-level security, so the job can read what is due with nobody
# signed in. Treat it like the database password.
SUPABASE_SERVICE_ROLE_KEY=

# A long random string you invent. The job's URL is public, so it checks this
# before doing anything; without it, anyone could fire the reminders.
CRON_SECRET=

# --- Meta / WhatsApp Cloud API ---------------------------------------------
# All four come out of the same place. The order to do it in:
#
#  1. developers.facebook.com -> My Apps -> Create App -> type "Business".
#  2. Add the WhatsApp product to it. You get a test number and a token that
#     expires in 24 hours — enough to prove the code works, not enough to
#     ship.
#  3. business.facebook.com -> Business Settings -> Business Info ->
#     Start Verification. Documents, and the name must match the registration.
#     Two to five working days, and nothing real sends until it passes.
#  4. Add the firm's own number. It must NOT be signed into the ordinary
#     WhatsApp Business app — if it is, that has to be deleted from the app
#     first, which loses that number's chat history. Worth choosing a second
#     number instead.
#  5. Business Settings -> Users -> System Users -> add one, give it the app
#     with the whatsapp_business_messaging permission, then Generate Token
#     with no expiry. That token is the one below.
#  6. WhatsApp Manager -> Message Templates -> create a Utility template for
#     the renewal reminder and submit it. Approval is usually a day or two.
#     Only an approved template can be sent to someone who has not messaged
#     first, which is the whole point here.
#
# Meta renames these panels often, so the paths may read slightly differently
# by the time you do it; the six steps themselves have been stable.

# WhatsApp Manager -> API Setup. A number, despite the name.
WHATSAPP_PHONE_NUMBER_ID=

# The System User token from step 5. Never expires, so if it leaks it is
# dangerous until revoked.
WHATSAPP_ACCESS_TOKEN=

# The approved template's exact name, e.g. amc_renewal_reminder.
WHATSAPP_TEMPLATE_NAME=

# The template's language code, as registered — usually en or en_US.
WHATSAPP_TEMPLATE_LANG=en
