{
  "name": "naveen-airtech",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @naveen/billing",
    "dev:quotations": "npm run dev -w @naveen/quotations",
    "build": "npm run build -w @naveen/billing",
    "build:billing": "npm run build -w @naveen/billing",
    "build:quotations": "npm run build -w @naveen/quotations",
    "build:all": "npm run build:billing && npm run build:quotations",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "jspdf": "^2.5.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "tailwindcss": "4.1.11",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
